# Only the reviewed Eigen CPU/MCTS closure; no network, desktop or GPU components.
set(go_dependency_root "${CMAKE_CURRENT_LIST_DIR}/../../../../../third_party/go-katago-upstream")
file(SHA256 "${go_dependency_root}/manifest.json" go_manifest_hash)
if(NOT go_manifest_hash STREQUAL "081f5e48bdd5979cfe9b342470b1c4ccf11570646d9a0949ab5933239958202a")
    message(FATAL_ERROR "Unreviewed Go dependency manifest")
endif()
file(READ "${go_dependency_root}/manifest.json" go_manifest)
string(JSON go_file_count LENGTH "${go_manifest}" files)
math(EXPR go_file_last "${go_file_count} - 1")
set(go_cpp_sources)
set(go_original_count 0)
foreach(go_index RANGE 0 ${go_file_last})
    string(JSON go_path GET "${go_manifest}" files ${go_index} path)
    if(NOT go_path MATCHES "^(source|eigen)/")
        continue()
    endif()
    if(go_path MATCHES "(^|/)\\.\\.(/|$)" OR go_path MATCHES "[\\\\:]")
        message(FATAL_ERROR "Invalid Go dependency path")
    endif()
    string(JSON go_expected_hash GET "${go_manifest}" files ${go_index} sha256)
    file(SHA256 "${go_dependency_root}/${go_path}" go_actual_hash)
    if(NOT go_actual_hash STREQUAL go_expected_hash)
        message(FATAL_ERROR "Original Go dependency differs: ${go_path}")
    endif()
    math(EXPR go_original_count "${go_original_count} + 1")
    if(go_path MATCHES "^source/cpp/.*\\.cpp$")
        list(APPEND go_cpp_sources "${go_dependency_root}/${go_path}")
    endif()
endforeach()
list(LENGTH go_cpp_sources go_cpp_count)
if(NOT go_original_count EQUAL 392 OR NOT go_cpp_count EQUAL 52)
    message(FATAL_ERROR "Go native dependency closure is incomplete")
endif()
add_library(mocs_go_katago STATIC ${go_cpp_sources})
set_target_properties(mocs_go_katago PROPERTIES POSITION_INDEPENDENT_CODE ON
    CXX_VISIBILITY_PRESET hidden VISIBILITY_INLINES_HIDDEN YES)
target_compile_features(mocs_go_katago PUBLIC cxx_std_17)
target_compile_definitions(mocs_go_katago PUBLIC USE_EIGEN_BACKEND EIGEN_MPL2_ONLY EIGEN_DONT_PARALLELIZE)
target_include_directories(mocs_go_katago SYSTEM PUBLIC
    "${go_dependency_root}/source/cpp" "${go_dependency_root}/eigen"
    "${go_dependency_root}/source/cpp/external/filesystem-1.5.8/include")
target_compile_options(mocs_go_katago PRIVATE -O2 -ffunction-sections -fdata-sections)
set_source_files_properties("${go_dependency_root}/source/cpp/core/sha2.cpp"
    "${go_dependency_root}/source/cpp/neuralnet/desc.cpp"
    PROPERTIES COMPILE_OPTIONS "-include;sys/endian.h")
target_link_libraries(mocs_go_katago PUBLIC z)
target_link_options(mocs_go_katago INTERFACE -Wl,--gc-sections)
